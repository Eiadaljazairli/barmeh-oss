# Required
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/souq_local
# Generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Empty = allow all origins (development only)
CORS_ORIGINS=
WEBSOCKET_CORS_ORIGIN=

# Image storage (empty = local ./uploads)
PUBLIC_BASE_URL=http://localhost:3000/uploads
CDN_URL=

# Optional: Google sign-in
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# Optional: email OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Barmeh <noreply@example.com>"

# Optional: admin alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional: AI moderation
GEMINI_API_KEY=

# Optional: mobile force-update gate
MOBILE_ANDROID_LATEST=1.0.0
MOBILE_ANDROID_MIN=1.0.0
MOBILE_ANDROID_STORE_URL=
MOBILE_IOS_LATEST=1.0.0
MOBILE_IOS_MIN=1.0.0
MOBILE_IOS_STORE_URL=

# Optional: observability
SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
